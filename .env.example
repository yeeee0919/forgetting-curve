# Chrome Web Store 已上架；預設連到正式商店頁。
# 若要覆寫，填完整網址；若要暫時改回 zip 下載，可在程式改預設或另行處理。
VITE_CHROME_EXTENSION_URL=https://chromewebstore.google.com/detail/doidjaenokgobflpfbeehhfmigjpkici

# 既有金鑰（若使用）
# VITE_GOOGLE_TTS_KEY=

# Supabase（前端可公開的 anon key）
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=

# 伺服器專用：AI 匯入。不要加 VITE_ 前綴，否則會進前端。
# OPENAI_API_KEY=sk-...
